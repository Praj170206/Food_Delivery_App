# MongoDB (Atlas connection string recommended - change streams power the live admin feed)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veg_delivery?retryWrites=true&w=majority

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public URL of the app (used in emails and CSRF origin checks)
APP_URL=http://localhost:3000

# SMTP (optional during development - emails are logged to the console if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GreenBite <no-reply@greenbite.app>"

# First admin account (used by `npm run seed:admin`). Use a strong, unique password - never commit it.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@greenbite.app
SEED_ADMIN_PASSWORD=

# Razorpay (test mode keys from dashboard.razorpay.com > Settings > API Keys; use rzp_test_... keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose when adding the webhook (Settings > Webhooks) for /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
